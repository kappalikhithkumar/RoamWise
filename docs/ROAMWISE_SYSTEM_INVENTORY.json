  "databaseTables": [
    {
      "tableName": "trips",
      "purpose": "Stores core trip metadata, dates, budgets, traveler types, and preferences",
      "columns": [
        "id",
        "destination",
        "start_date",
        "end_date",
        "budget_tier",
        "travel_style",
        "traveler_type",
        "pace",
        "weather_adaptive",
        "tagline",
        "destinations_json",
        "interests_json",
        "is_domestic",
        "created_at"
      ],
      "primaryKey": "id",
      "foreignKeys": []
    },
    {
      "tableName": "trip_days",
      "purpose": "Stores daily breakdown records, themes, dates, and day-level weather forecasts",
      "columns": [
        "id",
        "trip_id",
        "day_number",
        "day_of_week",
        "date_str",
        "theme",
        "weather_summary",
        "temperature",
        "rain_risk",
        "weather_condition",
        "weather_alert"
      ],
      "primaryKey": "id",
      "foreignKeys": [
        "trip_id -> trips.id (ON DELETE CASCADE)"
      ]
    },
    {
      "tableName": "activities",
      "purpose": "Stores individual activity stops, time slots, costs, locations, visited flags, and Plan B JSON alternatives",
      "columns": [
        "id",
        "day_id",
        "activity_key",
        "title",
        "time_slot",
        "period",
        "duration",
        "cost",
        "cost_display",
        "category",
        "location",
        "is_indoor",
        "weather_risk",
        "weather_risk_label",
        "description",
        "image_url",
        "is_visited",
        "is_locked",
        "is_plan_b_alternative",
        "has_plan_b_ready",
        "plan_b_alternative_json"
      ],
      "primaryKey": "id",
      "foreignKeys": [
        "day_id -> trip_days.id (ON DELETE CASCADE)"
      ]
    },
    {
      "tableName": "alerts",
      "purpose": "Stores environmental and schedule notifications linked to trips",
      "columns": [
        "id",
        "trip_id",
        "alert_type",
        "title",
        "message",
        "severity",
        "is_read",
        "created_at"
      ],
      "primaryKey": "id",
      "foreignKeys": [
        "trip_id -> trips.id (ON DELETE CASCADE)"
      ]
    }
  ],
  "environmentVariables": [
    {
      "name": "FLASK_APP",
      "description": "Entry point for Flask application",
      "default": "backend/run.py"
    },
    {
      "name": "FLASK_DEBUG",
      "description": "Enables Flask debug mode and hot reloading",
      "default": "True"
    },
    {
      "name": "PORT",
      "description": "Local HTTP port for Flask backend server",
      "default": "5000"
    },
    {
      "name": "HOST",
      "description": "Local bind host address",
      "default": "127.0.0.1"
    },
    {
      "name": "SECRET_KEY",
      "description": "Flask session encryption secret",
      "default": "roamwise-dev-secret-key"
    },
    {
      "name": "DATABASE_PATH",
      "description": "Absolute or relative path to SQLite database file",
      "default": "backend/roamwise.db"
    },
    {
      "name": "GEMINI_API_KEY",
      "description": "Google AI Studio API key for Gemini 2.5/3.5 models",
      "default": ""
    },
    {
      "name": "GEMINI_MODEL",
      "description": "Model identifier for Google GenAI SDK",
      "default": "gemini-3.5-flash-lite"
    },
    {
      "name": "WEATHER_PROVIDER",
      "description": "External atmospheric weather provider",
      "default": "open-meteo"
    }
  ],
  "externalProviders": {
    "ai": {
      "provider": "Google DeepMind / Google AI Studio",
      "sdk": "google-genai",
      "model": "gemini-3.5-flash-lite",
      "temperature": 0.6,
      "timeoutSeconds": 15.0
    },
    "weather": {
      "provider": "Open-Meteo Forecast & Geocoding APIs",
      "endpoints": [
        "https://api.open-meteo.com/v1/forecast",
        "https://geocoding-api.open-meteo.com/v1/search"
      ],
      "attribution": "Weather data by Open-Meteo.com (CC-BY 4.0)",
      "timeoutSeconds": 2.5
    },
    "poiDiscovery": {
      "tier1": "Curated Local Landmark Registry (14 major global hubs)",
      "tier2": "OpenStreetMap Overpass API (https://overpass-api.de/api/interpreter)",
      "timeoutSeconds": 3.5
    },
    "maps": {
      "rendering": "Internal SVG Canvas Schematic",
      "externalNavigation": "Google Maps Search and Direction URL Handlers"
    }
  },
