    },
    {
      "method": "POST",
      "url": "/api/trips",
      "purpose": "Save new trip with multi-day breakdown and activities",
      "status": "IMPLEMENTED"
    },
    {
      "method": "GET",
      "url": "/api/trips/<id>",
      "purpose": "Retrieve full trip details and daily schedules",
      "status": "IMPLEMENTED"
    },
    {
      "method": "PUT",
      "url": "/api/trips/<id>",
