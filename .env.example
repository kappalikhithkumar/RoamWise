# RoamWise AI Travel Planner Environment Variables
# Flask Backend Configuration
FLASK_APP=backend/run.py
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1
SECRET_KEY=roamwise-dev-secret-key-change-in-production

# SQLite Database
DATABASE_PATH=backend/roamwise.db

# Google Gemini API Key (keep private, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Weather Provider (Default: Open-Meteo free tier)
WEATHER_PROVIDER=open-meteo
